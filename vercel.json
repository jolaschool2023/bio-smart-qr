{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "env": {
    "BIOSMART_DB": "/tmp/biosmart.db",
    "BIOSMART_UPLOADS": "/tmp/biosmart-uploads",
    "BIOSMART_ADMIN_JSON": "/tmp/admin.json"
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(js|css|img|lib)/(.*)", "dest": "/public/$1/$2" },
    { "src": "/favicon.ico", "dest": "/public/favicon.ico" },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ]
}
